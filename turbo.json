{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env"],
  "globalPassThroughEnv": ["DATABASE_URL", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "LOG_LEVEL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
