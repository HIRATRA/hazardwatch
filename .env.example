# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL with the PostGIS extension. Matches compose.yaml for local dev.
DATABASE_URL=postgres://hazardwatch:hazardwatch@localhost:5433/hazardwatch

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the web app, used for callbacks and cookie scoping.
BETTER_AUTH_URL=http://localhost:3000
