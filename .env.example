# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL with the PostGIS extension. Matches compose.yaml for local dev.
DATABASE_URL=postgres://hazardwatch:hazardwatch@localhost:5433/hazardwatch

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the web app, used for callbacks and cookie scoping.
BETTER_AUTH_URL=http://localhost:3000

# Outgoing email. Locally, Mailpit from compose.yaml catches every message;
# read them at http://localhost:8025. In production, use your provider's SMTP
# URL, such as smtps://user:password@smtp.example.com:465. Leave it empty to
# send no email at all.
SMTP_URL=smtp://localhost:1025
# Sender of every email.
EMAIL_FROM=HazardWatch <alerts@hazardwatch.localhost>
# Public URL of the web app, for the links in the alert emails the worker sends.
APP_URL=http://localhost:3000

# Worker log level: fatal, error, warn, info, debug or trace.
LOG_LEVEL=info
