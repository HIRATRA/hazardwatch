    "test": "vitest run"
  },
  "dependencies": {
    "@hazardwatch/db": "workspace:*",
    "nodemailer": "^10.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
